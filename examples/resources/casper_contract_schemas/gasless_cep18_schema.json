    {
      "name": "transfer_with_authorization",
      "description": "Consumes a signed `TransferWithAuthorization` and moves `value` tokens from `from` to `to`. Any account may submit this call — the signature, not the caller, is what authorizes the transfer.  Reverts with [`Error::InvalidNonceLength`], [`Error::NonceAlreadyUsed`], [`Error::AuthorizationNotYetValid`], [`Error::AuthorizationExpired`], [`Error::InvalidPublicKey`], or [`Error::InvalidSignature`] if the corresponding precondition fails. On success, marks the nonce used, emits [`AuthorizationUsed`], and performs the transfer via [`Cep18::raw_transfer`].",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "from",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "to",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "amount",
          "description": null,
          "ty": "U256",
          "optional": false
        },
        {
          "name": "valid_after",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "valid_before",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "nonce",
          "description": null,
          "ty": {
            "List": "U8"
          },
          "optional": false
        },
        {
          "name": "public_key",
          "description": null,
          "ty": "PublicKey",
          "optional": false
        },
        {
          "name": "signature",
          "description": null,
          "ty": {
            "List": "U8"
          },
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "receive_with_authorization",
      "description": "Like [`Self::transfer_with_authorization`], but requires `caller == to`. This lets a receiving contract atomically accept a pre-signed transfer and act on it within the same call (e.g. a \"deposit then mint LP token\" flow), while preventing any other account from triggering the transfer at a moment of their choosing.  Reverts with [`Error::InvalidCaller`] if `caller != to`. All other checks and effects mirror `transfer_with_authorization`.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "from",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "to",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
