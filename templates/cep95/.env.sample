# Livenet configuration for the {{project-name}} CLI. Copy to `.env` (git-ignored) and fill in.
#
# The values below are for a local NCTL network started with:
#   docker run --rm -d --name mynctl -p 11101:11101 -p 14101:14101 -p 18101:18101 -p 25101:25101 makesoftware/casper-nctl:v203
# and the funded account key extracted with:
#   docker exec mynctl /bin/bash -c "cat /home/casper/casper-nctl/assets/net-1/users/user-1/secret_key.pem" > secret_key.pem
#
# For testnet use ODRA_CASPER_LIVENET_NODE_ADDRESS=https://node.testnet.cspr.cloud,
# ODRA_CASPER_LIVENET_EVENTS_URL=https://node.testnet.cspr.cloud/events, ODRA_CASPER_LIVENET_CHAIN_NAME=casper-test
# and a funded key of your own. Keep several files (e.g. `casper-test.env`) and pick one with
# ODRA_CASPER_LIVENET_ENV=casper-test.

ODRA_CASPER_LIVENET_SECRET_KEY_PATH=secret_key.pem
ODRA_CASPER_LIVENET_NODE_ADDRESS=http://localhost:11101
ODRA_CASPER_LIVENET_EVENTS_URL=http://localhost:18101/events
ODRA_CASPER_LIVENET_CHAIN_NAME=casper-net-1

# Optional: more accounts, available as env.get_account(1), (2), ...
# ODRA_CASPER_LIVENET_KEY_1=secret_key_1.pem
# Optional: CSPR.cloud auth token.
# CSPR_CLOUD_AUTH_TOKEN=
# Optional: log level (none, error, warn, info, debug).
# ODRA_LOG_LEVEL=info
